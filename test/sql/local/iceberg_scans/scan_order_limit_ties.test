# name: test/sql/local/iceberg_scans/scan_order_limit_ties.test
# description: #1089 LIMIT keep-loop with ties on the primary ORDER BY key and a secondary key
# group: [iceberg_scans]

require avro

require parquet

require iceberg

# ties_a/ties_b (scripts/topk_scan_order/generate.py): two files on day 5 whose rows all share ts = 2025-01-06
# 12:00 (ids 10-12 and 1-3), one day-6 file with 2 rows, one day-4 file. Unfiltered ORDER BY ts DESC, id DESC
# LIMIT 5 must return 61, 60, 12, 11, 10. The keep-loop counts a file toward the LIMIT when its lower bound is
# >= the next file's upper bound, so with equal bounds it keeps whichever tie file comes first and drops the
# other, although rows equal on ts are ordered by id.

statement ok
SET enable_external_file_cache=false;

statement ok
CALL enable_logging(['FileSystem']);

statement ok
CREATE TABLE o_ties_a AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_a/metadata/00004-18d33593-4483-40f1-a921-910448e2f002.metadata.json');

statement ok
CREATE TABLE o_ties_b AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_b/metadata/00004-10826d79-58d9-4860-887a-f708cc8eb1fd.metadata.json');

# 2. ties, boundary inside the tie, ties_a (threads=1)
statement ok
SET threads=1;

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_a/metadata/00004-18d33593-4483-40f1-a921-910448e2f002.metadata.json') ORDER BY ts DESC, id DESC LIMIT 5;

statement ok
CREATE OR REPLACE TABLE want AS SELECT id, ts FROM o_ties_a ORDER BY ts DESC, id DESC LIMIT 5;

query II
SELECT (SELECT count(*) FROM (FROM got EXCEPT ALL FROM want)) + (SELECT count(*) FROM (FROM want EXCEPT ALL FROM got)), (SELECT count(*) > 0 FROM want)::INT;
----
0	1


# 2. ties, boundary inside the tie, ties_b (threads=1)
statement ok
SET threads=1;

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_b/metadata/00004-10826d79-58d9-4860-887a-f708cc8eb1fd.metadata.json') ORDER BY ts DESC, id DESC LIMIT 5;

statement ok
CREATE OR REPLACE TABLE want AS SELECT id, ts FROM o_ties_b ORDER BY ts DESC, id DESC LIMIT 5;

query II
SELECT (SELECT count(*) FROM (FROM got EXCEPT ALL FROM want)) + (SELECT count(*) FROM (FROM want EXCEPT ALL FROM got)), (SELECT count(*) > 0 FROM want)::INT;
----
0	1


# 2. ties, boundary inside the tie, ties_a (threads=4)
statement ok
SET threads=1;

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_a/metadata/00004-18d33593-4483-40f1-a921-910448e2f002.metadata.json') ORDER BY ts DESC, id DESC LIMIT 5;

statement ok
CREATE OR REPLACE TABLE want AS SELECT id, ts FROM o_ties_a ORDER BY ts DESC, id DESC LIMIT 5;

query II
SELECT (SELECT count(*) FROM (FROM got EXCEPT ALL FROM want)) + (SELECT count(*) FROM (FROM want EXCEPT ALL FROM got)), (SELECT count(*) > 0 FROM want)::INT;
----
0	1


# 2. ties, boundary inside the tie, ties_b (threads=4)
statement ok
SET threads=1;

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_b/metadata/00004-10826d79-58d9-4860-887a-f708cc8eb1fd.metadata.json') ORDER BY ts DESC, id DESC LIMIT 5;

statement ok
CREATE OR REPLACE TABLE want AS SELECT id, ts FROM o_ties_b ORDER BY ts DESC, id DESC LIMIT 5;

query II
SELECT (SELECT count(*) FROM (FROM got EXCEPT ALL FROM want)) + (SELECT count(*) FROM (FROM want EXCEPT ALL FROM got)), (SELECT count(*) > 0 FROM want)::INT;
----
0	1

