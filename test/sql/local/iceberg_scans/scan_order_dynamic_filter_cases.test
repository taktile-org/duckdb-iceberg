# 8. UNION ALL: recent full branch + top-k branch, outer top-k (exporter shape) (threads=1)
statement ok
SET threads=1;

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS SELECT id, ts FROM (SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/scan_order_dynamic_filter/metadata/00008-68027992-f915-4363-9a69-16aaf856e256.metadata.json') WHERE env = 'live' AND ts >= TIMESTAMP '2025-01-08 06:00:00' UNION ALL (SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/scan_order_dynamic_filter/metadata/00008-68027992-f915-4363-9a69-16aaf856e256.metadata.json') WHERE env = 'live' AND ts < TIMESTAMP '2025-01-08 06:00:00' ORDER BY ts DESC, id LIMIT 5)) ORDER BY ts DESC, id LIMIT 5;

statement ok
