# name: test/sql/local/iceberg_scans/scan_order_dynamic_filter_cases.test
# description: TOP_N dynamic-filter manifest/file pruning against an eager oracle across table shapes
# group: [iceberg_scans]

require avro

require parquet

require iceberg

# Fixtures: scripts/topk_scan_order/generate.py (and scan_order_dynamic_filter, "days" below: 8 day-commits in
# shuffled order, 8 rows each 3h apart, ids day*8+slot, env alternating live/sandbox). Every case materializes the
# iceberg result into `got` and compares it, as a multiset, with the same query over `o_<table>`: a native copy made
# by a plain SELECT * iceberg_scan (no ORDER BY, so no scan order, no dynamic filter, the eager path). The ORDER BY
# keys are total, so the top-k set is unique. Manifest-read counts are asserted only at threads=1 where the TOP_N
# boundary is reached at a fixed point.

statement ok
SET enable_external_file_cache=false;

statement ok
CALL enable_logging(['FileSystem']);

statement ok
CREATE TABLE o_days AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/scan_order_dynamic_filter/metadata/00008-68027992-f915-4363-9a69-16aaf856e256.metadata.json');

statement ok
CREATE TABLE o_ties_a AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_a/metadata/00004-18d33593-4483-40f1-a921-910448e2f002.metadata.json');

statement ok
CREATE TABLE o_ties_b AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/ties_b/metadata/00004-10826d79-58d9-4860-887a-f708cc8eb1fd.metadata.json');

statement ok
CREATE TABLE o_nulls AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/nulls/metadata/00007-3b8e0334-5316-448c-a16e-af1f310d2047.metadata.json');

statement ok
CREATE TABLE o_hour AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/hour/metadata/00008-f4f55e27-4cf5-4389-8bf2-366a10ed40ab.metadata.json');

statement ok
CREATE TABLE o_month AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/month/metadata/00006-42a63140-88c2-47e1-9ea0-44b8e049e6fb.metadata.json');

statement ok
CREATE TABLE o_date_identity AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/date_identity/metadata/00008-c4394f27-d553-47e7-8b07-c2480d3fa477.metadata.json');

statement ok
CREATE TABLE o_evolved AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/evolved/metadata/00009-f75a14a5-a080-4cf4-a44e-eb0504434695.metadata.json');

statement ok
CREATE TABLE o_unpartitioned AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/unpartitioned/metadata/00005-bd383fe7-e87b-4e86-9fd3-3957d1b9bdd1.metadata.json');

statement ok
CREATE TABLE o_varchar_identity AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/varchar_identity/metadata/00008-feecade5-5808-4b23-bec3-2e423f74be69.metadata.json');

statement ok
CREATE TABLE o_struct AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/struct/metadata/00006-c90620d2-4a1e-40f7-a3fd-349c99d98255.metadata.json');

statement ok
CREATE TABLE o_pos_delete AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/pos_delete/metadata/v-final.metadata.json');

statement ok
CREATE TABLE o_eq_delete AS SELECT * FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/topk_scan_order/eq_delete/metadata/v-final.metadata.json');

statement ok
CREATE TABLE envs AS SELECT 'live' AS e;


# 1. ASC prunes (threads=1)
statement ok
SET threads=1;

statement ok
CALL truncate_duckdb_logs();

statement ok
CREATE OR REPLACE TABLE got AS SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/scan_order_dynamic_filter/metadata/00008-68027992-f915-4363-9a69-16aaf856e256.metadata.json') WHERE env = 'live' AND ts >= TIMESTAMP '2025-01-01 12:00:00' ORDER BY ts ASC, id LIMIT 3;

query I
SELECT count(DISTINCT path) FROM duckdb_logs_parsed('FileSystem') WHERE path LIKE '%-m0.avro';
----
2

statement ok
CREATE OR REPLACE TABLE want AS SELECT id, ts FROM o_days WHERE env = 'live' AND ts >= TIMESTAMP '2025-01-01 12:00:00' ORDER BY ts ASC, id LIMIT 3;

query II
SELECT (SELECT count(*) FROM (FROM got EXCEPT ALL FROM want)) + (SELECT count(*) FROM (FROM want EXCEPT ALL FROM got)), (SELECT count(*) > 0 FROM want)::INT;
----
0	1

query II
SELECT id, ts FROM iceberg_scan('__WORKING_DIRECTORY__/data/persistent/scan_order_dynamic_filter/metadata/00008-68027992-f915-4363-9a69-16aaf856e256.metadata.json') WHERE env = 'live' AND ts >= TIMESTAMP '2025-01-01 12:00:00' ORDER BY ts ASC, id LIMIT 3;
----
4	2025-01-01 12:00:00
6	2025-01-01 18:00:00
8	2025-01-02 00:00:00


